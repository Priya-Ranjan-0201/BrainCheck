# ============================================================
# Dockerized Quiz Application – .gitignore
# Keeps the repository clean by excluding generated, secret,
# and environment-specific files from version control.
# ============================================================

# ── Python bytecode & caches ────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/

# ── Testing & coverage ─────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ── Virtual environments ────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment & secrets ───────────────────────────────────
# NEVER commit real credentials. Use .env.example as a template.
.env
.env.*
!.env.example

# ── Database files ──────────────────────────────────────────
# SQLite databases are generated at runtime and should not
# be tracked. The schema is recreated by Flask on startup.
instance/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ── Log files ───────────────────────────────────────────────
*.log
logs/

# ── IDE & editor configurations ─────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.project
.settings/
.classpath

# ── OS-generated files ──────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
*.tmp
*.temp
*.bak
